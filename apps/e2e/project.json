{
  "name": "e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/e2e",
  "projectType": "application",
  "implicitDependencies": ["frontend", "backend"],
  "targets": {
    "e2e": {
      "outputs": ["{workspaceRoot}/apps/e2e/test-results"],
      "configurations": {
        "ci": {
          "workers": 1
        }
      }
    },
    "e2e:ui": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright test --ui",
        "cwd": "apps/e2e"
      }
    },
    "e2e:debug": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright test --debug",
        "cwd": "apps/e2e"
      }
    },
    "e2e:report": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright show-report",
        "cwd": "apps/e2e"
      }
    }
  },
  "tags": ["type:e2e", "scope:testing"]
}
