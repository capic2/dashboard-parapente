#!/bin/sh
set -eu

# Ensure node/pnpm are in PATH (nvm/fnm)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

PNPM_BIN="${PNPM_BIN:-}"
if [ -z "$PNPM_BIN" ] && command -v pnpm >/dev/null 2>&1; then
  PNPM_BIN=$(command -v pnpm)
elif [ -z "$PNPM_BIN" ] && [ -x /home/capic/.local/share/pnpm/pnpm ]; then
  PNPM_BIN=/home/capic/.local/share/pnpm/pnpm
fi
if [ -z "$PNPM_BIN" ]; then
  echo "pnpm is required for pre-commit checks" >&2
  exit 1
fi

if git diff --cached --name-only --diff-filter=ACMR -- apps/backend | grep -Eq '\.py$'; then
  echo "Backend Python files are staged; checking local workspace dependencies..."
  ./scripts/bootstrap-local.sh
fi

"$PNPM_BIN" exec lint-staged
"$PNPM_BIN" knip
