# ==========================================
# Dashboard Parapente - Configuration
# ==========================================
#
# Instructions :
# 1. Copier ce fichier vers .env
# 2. Remplacer les valeurs par vos vraies clés API
# 3. Ajuster selon votre environnement (dev/prod)
#
# Note : .env est git-ignoré pour protéger vos secrets
#
# Development tips :
# - En dev : Utiliser BACKEND_USE_FAKE_REDIS=true
# - En dev : Augmenter BACKEND_LOG_LEVEL=DEBUG
# - En prod : BACKEND_LOG_LEVEL=INFO, BACKEND_USE_FAKE_REDIS=false
# ==========================================

# ==========================================
# GLOBAL
# ==========================================

# Environment: development | production
ENVIRONMENT=development

# Production image used by Portainer. The main tag is updated on every main deployment.
BACKEND_IMAGE=ghcr.io/capic2/dashboard-parapente/backend:main

# ==========================================
# BACKEND CONFIGURATION
# ==========================================

# Database (required, no application default)
# Development: SQLite local (relatif au dossier backend/)
# Production: Chemin complet ou autre DB
BACKEND_DATABASE_URL=sqlite:///./db/dashboard.db
# Required by standalone migration scripts.
DATABASE_URL=sqlite:///./db/dashboard.db

# Redis Cache
# Development: Utiliser fake redis (in-memory, pas de Docker requis)
# Production: Pointer vers le conteneur Redis
BACKEND_REDIS_HOST=redis
BACKEND_REDIS_PORT=6379
BACKEND_USE_FAKE_REDIS=true

# API Server
BACKEND_API_HOST=0.0.0.0
BACKEND_API_PORT=8001
BACKEND_API_DEBUG=false

# Weather API Keys
# WeatherAPI: https://www.weatherapi.com/signup.aspx
# Free tier: 1M requests/month
BACKEND_WEATHERAPI_KEY=your_weatherapi_key_here

# Meteoblue: https://www.meteoblue.com/en/account/apikeys
# Free tier: 50 requests/day
BACKEND_METEOBLUE_API_KEY=your_meteoblue_key_here

# SpotAiR balises API key
# Request access from SpotAiR / balises data provider
BACKEND_SPOTAIR_BALISES_API_KEY=your_spotair_balises_key_here

# SIA AZBA / RTBA official activity API
# The public SIA AZBA web app uses the v3 endpoints and a signed AUTH header.
BACKEND_AZBA_API_BASE_URL=https://bo-prod-sofia-vac.sia-france.fr/api/
BACKEND_AZBA_API_VERSION=v3/
BACKEND_AZBA_API_AUTH_SECRET=your_sia_azba_auth_secret_here
BACKEND_AZBA_CACHE_TTL_SECONDS=900
BACKEND_AZBA_SITE_RADIUS_KM=10

# Authentication (JWT)
# Generate secret: openssl rand -hex 32
BACKEND_JWT_SECRET=__GENERATE_WITH_openssl_rand_-hex_32__
BACKEND_JWT_EXPIRE_HOURS=168
BACKEND_ADMIN_EMAIL=__YOUR_ADMIN_EMAIL__
BACKEND_ADMIN_PASSWORD=__YOUR_STRONG_PASSWORD__

# Strava OAuth
# Get credentials: https://www.strava.com/settings/api
# 1. Create an app to get Client ID and Secret
# 2. Use OAuth flow to get Access and Refresh tokens
BACKEND_STRAVA_CLIENT_ID=your_client_id
BACKEND_STRAVA_CLIENT_SECRET=your_client_secret
BACKEND_STRAVA_ACCESS_TOKEN=your_access_token
BACKEND_STRAVA_REFRESH_TOKEN=your_refresh_token
BACKEND_STRAVA_VERIFY_TOKEN=PARAPENTE_2025
BACKEND_STRAVA_TOKEN_LOG_HISTORY_LIMIT=5

# AI Analysis (Emagram)
# Default order maximizes free/low-cost fallbacks before custom paid endpoints.
BACKEND_LLM_FALLBACK_ORDER=groq,openrouter,github_models,huggingface,google,custom_openai
BACKEND_LLM_QUOTA_COOLDOWN_SECONDS=3600

# Groq Llama Vision: https://console.groq.com/keys
BACKEND_GROQ_API_KEY=your_groq_api_key_here
BACKEND_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# OpenRouter vision models: https://openrouter.ai/keys
BACKEND_OPENROUTER_API_KEY=your_openrouter_api_key_here
BACKEND_OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free
BACKEND_OPENROUTER_MODELS=qwen/qwen2.5-vl-72b-instruct:free,google/gemini-2.0-flash-exp:free,mistralai/mistral-small-3.2-24b-instruct:free

# GitHub Models: https://github.com/marketplace/models
BACKEND_GITHUB_MODELS_API_KEY=your_github_token_here
BACKEND_GITHUB_MODELS_BASE_URL=https://models.github.ai/inference/v1/chat/completions
BACKEND_GITHUB_MODELS_MODELS=openai/gpt-4o-mini

# Hugging Face Router: https://huggingface.co/settings/tokens
BACKEND_HUGGINGFACE_API_KEY=your_huggingface_token_here
BACKEND_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1/chat/completions
BACKEND_HUGGINGFACE_MODELS=Qwen/Qwen2.5-VL-7B-Instruct

# Any OpenAI-compatible vision endpoint.
BACKEND_CUSTOM_OPENAI_API_KEY=your_custom_openai_key_here
BACKEND_CUSTOM_OPENAI_BASE_URL=https://example.com/v1/chat/completions
BACKEND_CUSTOM_OPENAI_MODELS=your/provider-vision-model

# Google Gemini: https://aistudio.google.com/app/apikey
BACKEND_GOOGLE_API_KEY=your_google_api_key_here
BACKEND_GEMINI_MODEL=gemini-2.5-flash

# Scheduler
# Automatically refresh weather data at regular intervals
BACKEND_SCHEDULER_ENABLED=true
BACKEND_SCHEDULER_INTERVAL_MINUTES=30

# Cache TTL (seconds) - default values, can be overridden from the Settings UI
# BACKEND_CACHE_TTL_DEFAULT: TTL for weather source data in Redis
# BACKEND_CACHE_TTL_SUMMARY: TTL for site summary data in Redis
BACKEND_CACHE_TTL_DEFAULT=3600
BACKEND_CACHE_TTL_SUMMARY=3600

# Logging (BACKEND_LOG_FILE is required, no application default)
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Development: DEBUG or INFO
# Production: INFO or WARNING
BACKEND_LOG_LEVEL=INFO
BACKEND_LOG_FILE=logs/dashboard.log

# Monitoring / Metrics
# Use the same token in the app stack and the monitoring stack
BACKEND_METRICS_TOKEN=__GENERATE_RANDOM_TOKEN__
MONITORING_METRICS_TOKEN=__SAME_AS_BACKEND_METRICS_TOKEN__
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE_STRONG_PASSWORD__

# Telegram Alerts (Optional)
# Get bot token: https://t.me/BotFather
# Get chat ID: https://t.me/userinfobot
# Leave empty to disable notifications
BACKEND_TELEGRAM_BOT_TOKEN=
BACKEND_TELEGRAM_CHAT_ID=

# Frontend URL (for CORS, optional)
# Development: http://localhost:5173
# Production: Your deployed frontend URL
BACKEND_FRONTEND_URL=http://localhost:5173

# Host folders mounted at fixed backend container paths.
# GOPRO_OVERLAY_DATA_HOST_DIR is mounted at /app/parapente.
# GOPRO_OVERLAY_BUILD_CONTEXT is copied into the image at /app/gopro-overlay.
GOPRO_OVERLAY_BUILD_CONTEXT=https://github.com/capic2/gopro-dashboard-overlay.git#main
GOPRO_OVERLAY_DATA_HOST_DIR=/media/nas/DS211_Synology_2/parapente

# Deployment version state file (required, no application default).
BACKEND_VERSION_STATE_FILE=/app/db/version_state.json

# ==========================================
# FRONTEND CONFIGURATION (Vite)
# ==========================================

# MSW (Mock Service Worker)
# Enable mock data for development/testing
# Set to 'false' to use real backend API
# Default: true (use mocks in dev)
VITE_ENABLE_MSW=true

# API URL
# Point to your backend server
# Development: http://localhost:8001
# Production: Your deployed backend URL
VITE_API_URL=http://localhost:8001

# Cesium Ion token (required for World Terrain in production)
# Create a token: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

CHROMATIC_PROJECT_TOKEN=
