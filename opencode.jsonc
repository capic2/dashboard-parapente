{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/gpt-5.3-codex",
  "small_model": "opencode/gpt-5.4-mini",
  "default_agent": "build",
  "instructions": [
    "AGENTS.md",
    "apps/frontend/AGENTS.md",
    "apps/backend/AGENTS.md"
  ],
  "agent": {
    "build": {
      "description": "Implementation agent for code changes",
      "model": "opencode/gpt-5.3-codex",
      "temperature": 0.2,
      "steps": 60
    },
    "ship": {
      "description": "Lightweight git workflow agent",
      "mode": "subagent",
      "model": "opencode/gpt-5.4-mini",
      "temperature": 0.1,
      "steps": 20,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git branch*": "allow",
          "git switch*": "allow",
          "git checkout*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "git push*": "allow",
          "gh auth status*": "allow",
          "gh pr create*": "allow",
          "gh pr list*": "allow",
          "gh pr status*": "allow",
          "gh pr view*": "allow"
        }
      }
    }
  },
  "command": {
    "ship": {
      "description": "Create branch, commit, push, and open a PR",
      "agent": "ship",
      "model": "opencode/gpt-5.4-mini",
      "subtask": true,
      "template": "Repo snapshot:\nStatus: !`git status --short --branch`\nDiff stat: !`git diff --stat`\nRecent commits: !`git log --oneline -5`\n\nCreate the smallest safe branch, make a conventional commit, push it, and open a pull request if a remote is configured. Keep the changes scoped to the current task and avoid unrelated edits."
    }
  }
}
