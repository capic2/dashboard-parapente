{
  "name": "paragliding-dashboard",
  "version": "1.0.0",
  "description": "Paragliding Dashboard - Weather, Flights, and Analytics - Nx Monorepo",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "nx run-many -t serve -p frontend,backend --parallel",
    "build": "nx run-many -t build --all",
    "build:prod": "nx run-many -t build --all --configuration=production",
    "test": "nx run-many -t test --all",
    "test:affected": "nx affected -t test",
    "test:e2e": "nx e2e e2e",
    "test:e2e:ui": "nx e2e:ui e2e",
    "test:e2e:debug": "nx e2e:debug e2e",
    "test:e2e:report": "nx e2e:report e2e",
    "check:worktree": "./scripts/git/check-worktree-policy.sh",
    "lint": "nx run-many -t lint --all",
    "lint:affected": "nx affected -t lint",
    "format": "nx run-many -t format --all",
    "graph": "nx graph",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-table": "catalog:",
    "cesium": "catalog:",
    "date-fns": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "ky": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-is": "catalog:",
    "recharts": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@nx/playwright": "catalog:",
    "@nx/vite": "catalog:",
    "@nx/vitest": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "chromatic": "catalog:",
    "happy-dom": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "msw": "catalog:",
    "msw-storybook-addon": "catalog:",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "storybook-react-i18next": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-cesium": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "apps/frontend/src/**/!(routeTree.gen).{ts,tsx}": [
      "oxlint -c .oxlintrc.json",
      "oxfmt -c .oxfmtrc.json"
    ],
    "libs/design-system/src/**/*.{ts,tsx}": [
      "oxlint -c .oxlintrc.json",
      "oxfmt -c .oxfmtrc.json"
    ],
    "libs/shared-types/src/**/*.{ts,tsx}": [
      "oxlint -c .oxlintrc.json",
      "oxfmt -c .oxfmtrc.json"
    ],
    "apps/backend/**/*.py": [
      "apps/backend/.venv/bin/ruff check --output-format=github",
      "apps/backend/.venv/bin/black"
    ]
  },
  "msw": {
    "workerDirectory": [
      "apps/frontend/public"
    ]
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    }
  }
}
